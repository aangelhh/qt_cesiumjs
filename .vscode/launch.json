    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch qttest",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-macos-ros2/qttest.app/Contents/MacOS/qttest",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "environment": [
                {
                    "name": "AMENT_PREFIX_PATH",
                    "value": "${workspaceFolder}/build-ros2-workspace/install/qttest_interfaces:/Users/angelconde/ros2_tactical/.pixi/envs/default"
                },
                {
                    "name": "COLCON_PREFIX_PATH",
                    "value": "${workspaceFolder}/build-ros2-workspace/install"
                },
                {
                    "name": "RMW_IMPLEMENTATION",
                    "value": "rmw_fastrtps_cpp"
                },
                {
                    "name": "ROS_DISTRO",
                    "value": "jazzy"
                },
                {
                    "name": "ROS_VERSION",
                    "value": "2"
                },
                {
                    "name": "QTTEST_STONESOUP_PYTHON",
                    "value": "${workspaceFolder}/build-macos-ros2/stonesoup-venv/bin/python"
                },
                {
                    "name": "QTTEST_MIXR_SENSOR_PLUGIN",
                    "value": "${workspaceFolder}/build-macos-ros2/sensor-plugins/libqttest_mixr_sensor.dylib"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "CMake Build ROS 2",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for lldb",
                    "text": "settings set target.max-children-count 256",
                    "ignoreFailures": true
                }
            ],
