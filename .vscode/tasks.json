{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build-macos-debug",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_PREFIX_PATH=/Users/angelconde/Qt/6.10.2/macos",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Configura el proyecto con CMake en una carpeta de build separada para macOS"
        },
        {
            "label": "CMake Setup Stone Soup",
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake Configure"
            ],
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build-macos-debug",
                "--target",
                "qttest_setup_stonesoup"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Prepara una vez el entorno aislado Stone Soup para el build Debug"
        },
        {
            "label": "CMake Setup MIXR",
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake Setup Stone Soup"
            ],
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build-macos-debug",
                "--target",
                "qttest_setup_mixr"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compila MIXR y el plugin radar nativo para macOS"
        },
        {
            "label": "CMake Build",
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake Setup MIXR"
            ],
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build-macos-debug",
                "--",
                "-j4"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Construye el proyecto desde la carpeta build de macOS en modo Debug"
        },
        {
            "label": "CMake Configure Windows",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build-windows",
                "-A",
                "x64",
                "-DCMAKE_PREFIX_PATH=C:/Qt/6.10.2/msvc2022_64",
                "-DQTTEST_ENABLE_MIXR_SENSOR_PROVIDER=ON",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "group": "build",
            "problemMatcher": [
                "$msCompile"
            ],
            "detail": "Configura Windows con Qt 6.10.2 para MSVC y habilita MIXR"
        },
        {
            "label": "CMake Build Windows",
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake Configure Windows"
            ],
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build-windows",
                "--config",
                "Release",
                "--target",
                "qttest",
                "--parallel",
                "4"
            ],
            "group": "build",
            "problemMatcher": [
                "$msCompile"
            ],
            "detail": "Construye qttest y el plugin MIXR para Windows"
        },
        {
            "label": "CMake Run Tests",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--test-dir",
                "build-macos-debug",
                "--output-on-failure"
            ],
            "group": "test",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Ejecuta tests desde la carpeta build de macOS"
        },
        {
            "label": "CMake Configure ROS 2",
            "type": "process",
            "command": "/Users/angelconde/.pixi/bin/pixi",
            "args": [
                "run",
                "--manifest-path",
                "/Users/angelconde/ros2_tactical/pixi.toml",
                "cmake",
                "-S",
                ".",
                "-B",
                "build-macos-ros2",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DQTTEST_ENABLE_ROS2_TELEMETRY=ON",
                "-DCMAKE_PREFIX_PATH=${workspaceFolder}/build-ros2-workspace/install/qttest_interfaces;/Users/angelconde/ros2_tactical/.pixi/envs/default;/Users/angelconde/Qt/6.10.2/macos",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Configura qttest con el backend nativo ROS 2/DDS"
        },
        {
            "label": "CMake Setup Stone Soup ROS 2",
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake Configure ROS 2"
            ],
            "type": "process",
            "command": "/Users/angelconde/.pixi/bin/pixi",
            "args": [
                "run",
                "--manifest-path",
                "/Users/angelconde/ros2_tactical/pixi.toml",
                "cmake",
                "--build",
                "build-macos-ros2",
                "--target",
                "qttest_setup_stonesoup"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Prepara una vez el entorno aislado Stone Soup para el build ROS 2"
        },
        {
            "label": "CMake Setup MIXR ROS 2",
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake Setup Stone Soup ROS 2"
            ],
            "type": "process",
            "command": "/Users/angelconde/.pixi/bin/pixi",
            "args": [
                "run",
                "--manifest-path",
                "/Users/angelconde/ros2_tactical/pixi.toml",
                "cmake",
                "--build",
                "build-macos-ros2",
                "--target",
                "qttest_setup_mixr"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Compila MIXR y el plugin radar para el build ROS 2"
        },
        {
            "label": "CMake Build ROS 2",
            "dependsOrder": "sequence",
            "dependsOn": [
                "CMake Setup MIXR ROS 2"
            ],
            "type": "process",
            "command": "/Users/angelconde/.pixi/bin/pixi",
            "args": [
                "run",
                "--manifest-path",
                "/Users/angelconde/ros2_tactical/pixi.toml",
                "cmake",
                "--build",
                "build-macos-ros2",
                "--target",
                "qttest",
                "--parallel",
                "2"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Construye qttest con soporte nativo ROS 2/DDS"
        },
        {
            "label": "Launch PlotJuggler ROS 2",
            "type": "process",
            "command": "/Users/angelconde/.pixi/bin/pixi",
            "args": [
                "run",
                "--manifest-path",
                "/Users/angelconde/ros2_tactical/pixi.toml",
                "zsh",
                "${workspaceFolder}/integrations/ros2/run_plotjuggler.zsh"
            ],
            "problemMatcher": [],
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": false
            },
            "detail": "Abre PlotJuggler con ROS 2 y qttest_interfaces cargados"
        }
    ]
}
