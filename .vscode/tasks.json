{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_PREFIX_PATH=/Users/angelconde/Qt/6.10.2/macos"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Configura el proyecto con CMake"
        },
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--",
                "-j4"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Construye el proyecto desde la carpeta build principal en modo estable para macOS"
        },
        {
            "label": "CMake Run Tests",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--test-dir",
                "build",
                "--output-on-failure"
            ],
            "group": "test",
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Ejecuta tests desde la carpeta build"
        }
    ]
}
