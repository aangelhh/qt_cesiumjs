/* Qttest Windows modern theme. Loaded automatically by main.cpp on Windows. */
QWidget {
    font-family: "Segoe UI Variable", "Segoe UI";
    font-size: 10pt;
    color: #172033;
}

QMainWindow {
    background: #f7f9fc;
}

QDialog {
    background: #ffffff;
}

QWidget#centralwidget,
QWidget#objectsDockContents,
QWidget#contactsDockContents,
QWidget#controlDockContents,
QWidget#propertiesTab,
QWidget#tasksTab,
QWidget#logTab {
    background: #ffffff;
}

QScrollArea, QScrollArea > QWidget > QWidget {
    background: #ffffff;
}

QFrame#topStatusFrame {
    background: #ffffff;
    border: 1px solid #dfe4ec;
    border-radius: 6px;
}

QFrame#viewerFrame {
    background: #101722;
    border: 1px solid #cbd3df;
    border-radius: 4px;
}

QLabel#statusLabel {
    color: #46566f;
}

QDockWidget {
    background: #ffffff;
    color: #172033;
}

QDockWidget::title {
    background: #f4f7fb;
    border-bottom: 1px solid #dfe4ec;
    padding: 7px 8px;
}

QMenuBar {
    background: #ffffff;
    border-bottom: 1px solid #dfe4ec;
    padding: 3px 6px;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
    border-radius: 5px;
}

QMenuBar::item:selected {
    background: #e8e8e8;
}

QMenu {
    background: #fbfbfb;
    border: 1px solid #d8d8d8;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 28px 7px 10px;
    border-radius: 5px;
}

QMenu::item:selected {
    background: #e6f2ff;
    color: #0f4c81;
}

QPushButton, QToolButton {
    min-height: 28px;
    background: #ffffff;
    border: 1px solid #cfcfcf;
    border-radius: 6px;
    padding: 4px 12px;
}

QPushButton:hover, QToolButton:hover {
    background: #f8f8f8;
    border-color: #b9b9b9;
}

QPushButton:pressed, QToolButton:pressed {
    background: #ececec;
}

QPushButton:default {
    background: #0067c0;
    color: white;
    border-color: #005fb8;
}

QPushButton:default:hover {
    background: #1975c5;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit {
    min-height: 28px;
    background: #ffffff;
    border: 1px solid #c9c9c9;
    border-radius: 6px;
    padding: 2px 8px;
    selection-background-color: #0067c0;
    selection-color: white;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus,
QDateEdit:focus, QTimeEdit:focus {
    border: 2px solid #0067c0;
    padding: 1px 7px;
}

QComboBox::drop-down {
    width: 26px;
    border: 0;
}

QGroupBox {
    background: #fafafa;
    border: 1px solid #dedede;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    color: #3a3a3a;
}

QTabWidget::pane {
    background: #fafafa;
    border: 1px solid #dcdcdc;
    border-radius: 8px;
}

QTabBar::tab {
    background: transparent;
    border: 0;
    border-bottom: 3px solid transparent;
    padding: 8px 14px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    background: #ebebeb;
    border-radius: 5px;
}

QTabBar::tab:selected {
    color: #005a9e;
    border-bottom-color: #0067c0;
}

QTableView, QTreeView, QListView {
    background: #ffffff;
    alternate-background-color: #f8f8f8;
    border: 1px solid #dddddd;
    border-radius: 7px;
    gridline-color: #ededed;
    selection-background-color: #d9ecff;
    selection-color: #1f1f1f;
}

QHeaderView::section {
    background: #f5f5f5;
    border: 0;
    border-right: 1px solid #e2e2e2;
    border-bottom: 1px solid #d9d9d9;
    padding: 6px 8px;
}

QScrollBar:vertical {
    background: transparent;
    width: 12px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #b9b9b9;
    min-height: 28px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: #979797;
}

QScrollBar:horizontal {
    background: transparent;
    height: 12px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #b9b9b9;
    min-width: 28px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: #979797;
}

QScrollBar::add-line, QScrollBar::sub-line,
QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
    border: 0;
}

QCheckBox, QRadioButton {
    spacing: 7px;
}

QStatusBar {
    background: #ffffff;
    border-top: 1px solid #dfe4ec;
}

QToolTip {
    background: #ffffff;
    color: #1f1f1f;
    border: 1px solid #cfcfcf;
    border-radius: 5px;
    padding: 5px;
}
